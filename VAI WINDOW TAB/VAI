        // Gist Cloud Sync
        async function saveDataToGist() {
            if (!githubToken) return;
            const payload = { [currentUserId]: { sessions, todos: smartTodos, transactions, updated: new Date().toISOString() } };
            try {
                let url = 'https://api.github.com/gists';
                let method = 'POST';
                if (githubGistId) {
                    url = `https://api.github.com/gists/${githubGistId}`;
                    method = 'PATCH';
                }
                const res = await fetch(url, {
                    method: method,
                    headers: { 'Authorization': `token ${githubToken}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description: 'Nexus Workspace Data', public: false, files: { 'nexus_data.json': { content: JSON.stringify(payload, null, 2) } } })
                });
                if (res.ok) {
                    const data = await res.json();
                    if (!githubGistId && data.id) {
                        githubGistId = data.id;
                        localStorage.setItem('nexus_gist_id', githubGistId);
                    }
                    logActivity("Tersinkronisasi.");
                }
            } catch (e) { logActivity("Gagal sinkron."); }
        }

        async function fetchDataFromGist() {
            if (!githubToken || !githubGistId) return;
            try {
                const res = await fetch(`https://api.github.com/gists/${githubGistId}`, { headers: { 'Authorization': `token ${githubToken}` } });
                if (res.ok) {
                    const data = await res.json();
                    const content = data.files['nexus_data.json']?.content;
                    if (content) {
                        const parsed = JSON.parse(content);
                        if (parsed[currentUserId]) {
                            sessions = parsed[currentUserId].sessions || sessions;
                            smartTodos = parsed[currentUserId].todos || smartTodos;
                            transactions = parsed[currentUserId].transactions || transactions;
                            renderSessionsList();
                            renderActiveSessionChat();
                            renderTodos();
                            renderTransactions();
                            updateAnalytics();
                            logActivity("Data dimuat.");
                        }
                    }
                }
            } catch (e) { console.error(e); }
        }


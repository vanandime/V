        function getPersonaSystemPrompt() {
            const selectedPersona = document.querySelector('input[name="ai-persona"]:checked')?.value || 'default';
            if (selectedPersona === 'programmer') return "Anda adalah Senior Programmer profesional yang memberikan solusi kode efisien dan terstruktur.";
            if (selectedPersona === 'copywriter') return "Anda adalah Creative Copywriter profesional yang menggunakan bahasa persuasif dan menarik.";
            return "Anda adalah asisten AI yang ramah, netral, dan membantu.";
        }

        async function callGroq(prompt) {
            const personaPrompt = getPersonaSystemPrompt();
            const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
                method: "POST",
                headers: { "Authorization": `Bearer ${GROQ_KEY}`, "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: "llama3-70b-8192",
                    messages: [
                        { role: "system", content: personaPrompt },
                        { role: "user", content: prompt }
                    ]
                })
            });
            if (!res.ok) throw new Error("Groq API Error");
            const data = await res.json();
            return data.choices?.[0]?.message?.content;
        }

        async function callGemini(prompt) {
            const personaPrompt = getPersonaSystemPrompt();
            const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${GEMINI_KEY}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ contents: [{ parts: [{ text: `${personaPrompt}\n\n${prompt}` }] }] })
            });
            if (!res.ok) throw new Error("Gemini API Error");
            const data = await res.json();
            return data.candidates?.[0]?.content?.parts?.[0]?.text;
        }

        async function callOpenAI(prompt) {
            if (!OPENAI_KEY) throw new Error("OpenAI Key Missing");
            const personaPrompt = getPersonaSystemPrompt();
            const res = await fetch("https://api.openai.com/v1/chat/completions", {
                method: "POST",
                headers: { "Authorization": `Bearer ${OPENAI_KEY}`, "Content-Type": "application/json" },
                body: JSON.stringify({
                    model: "gpt-4o-mini",
                    messages: [
                        { role: "system", content: personaPrompt },
                        { role: "user", content: prompt }
                    ]
                })
            });
            if (!res.ok) throw new Error("OpenAI API Error");
            const data = await res.json();
            return data.choices?.[0]?.message?.content;
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            const sess = getCurrentSession();
            if (sess.history.length === 0) {
                sess.title = text.length > 25 ? text.substring(0, 25) + '...' : text;
            }

            hybridMsgList.innerHTML += `<div class="flex justify-end"><div class="bg-neutral-900 text-white px-3.5 py-2 rounded-2xl text-xs max-w-[85%]">${text}</div></div>`;
            chatInput.value = '';

            const aiId = 'ai-' + Date.now();
            hybridMsgList.innerHTML += `<div id="${aiId}" class="flex justify-start"><div class="bg-neutral-100 text-neutral-800 px-3.5 py-2 rounded-2xl text-xs max-w-[85%] animate-pulse">Hybrid AI memproses...</div></div>`;

            let reply = null;
            let usedModel = "Groq Llama-3";

            try {
                // Coba OpenAI jika tersedia, jika tidak ke Groq
                if (OPENAI_KEY) {
                    try {
                        reply = await callOpenAI(text);
                        usedModel = "OpenAI GPT-4o-mini";
                        aiStatusBadge.textContent = "OpenAI Active";
                        aiStatusBadge.className = "px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-mono text-[9px]";
                    } catch (openAiErr) {
                        reply = await callGroq(text);
                        aiStatusBadge.textContent = "Groq Active";
                        aiStatusBadge.className = "px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-mono text-[9px]";
                    }
                } else {
                    reply = await callGroq(text);
                    aiStatusBadge.textContent = "Groq Active";
                    aiStatusBadge.className = "px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-mono text-[9px]";
                }
            } catch (groqErr) {
                console.warn("Primary failed, auto-fixing with Gemini backup...", groqErr);
                aiStatusBadge.textContent = "Auto-Fix (Gemini)";
                aiStatusBadge.className = "px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 font-mono text-[9px]";
                
                try {
                    reply = await callGemini(text);
                    usedModel = "Gemini Flash (Auto-Fixed)";
                } catch (geminiErr) {
                    reply = "Maaf, semua koneksi Hybrid AI gagal merespons. Periksa kunci API Anda.";
                    usedModel = "Gagal";
                }
            }

            document.getElementById(aiId).innerHTML = `<div class="bg-white border border-neutral-200 text-neutral-800 px-3.5 py-2 rounded-2xl text-xs max-w-[85%] shadow-xs space-y-1"><div class="text-[9px] font-mono text-neutral-400">Model: ${usedModel}</div><div>${marked.parse(reply)}</div></div>`;
            
            sess.history.push({ role: 'user', content: text });
            sess.history.push({ role: 'assistant', content: reply, model: usedModel });

            localStorage.setItem('nexus_chat_sessions', JSON.stringify(sessions));
            saveDataToGist();
            renderSessionsList();
        });

        renderSessionsList();
        renderActiveSessionChat();
        renderTodos();
        renderTransactions();
        fetchDataFromGist();
    </script>
</body>
</html>

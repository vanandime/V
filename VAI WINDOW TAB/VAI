                logs.appendChild(div);
                logs.scrollTop = logs.scrollHeight;
            }
        }

        // Session Management
        function getCurrentSession() {
            let sess = sessions.find(s => s.id === activeSessionId);
            if (!sess) {
                sess = sessions[0];
                activeSessionId = sess.id;
            }
            return sess;
        }


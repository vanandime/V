                if (msg.role === 'user') {
                    hybridMsgList.innerHTML += `<div class="flex justify-end"><div class="bg-neutral-900 text-white px-3.5 py-2 rounded-2xl text-xs max-w-[85%]">${msg.content}</div></div>`;
                } else {
                    hybridMsgList.innerHTML += `<div class="flex justify-start"><div class="bg-white border border-neutral-200 text-neutral-800 px-3.5 py-2 rounded-2xl text-xs max-w-[85%] shadow-xs space-y-1"><div class="text-[9px] font-mono text-neutral-400">Model: ${msg.model || 'Hybrid AI'}</div><div>${marked.parse(msg.content)}</div></div></div>`;

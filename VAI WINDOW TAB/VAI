<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexus Workspace</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Marked.js for Markdown Rendering -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; height: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #d4d4d8; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #a1a1aa; }
        /* Uniform tab width constraint */
        .tab-btn { min-width: 82px; text-align: center; }
    </style>
</head>
<body class="bg-white text-neutral-900 h-full flex flex-col overflow-hidden relative select-none">

    <!-- Workspace Viewport Container -->
    <main id="workspace-canvas" class="flex-1 relative overflow-hidden flex flex-col pb-16">

        <!-- Chat Sidebar Drawer -->
        <div id="chat-sidebar-drawer" class="absolute inset-y-0 left-0 w-72 bg-white border-r border-neutral-200 z-30 shadow-2xl flex flex-col transition-transform duration-300 -translate-x-full">
            <div class="flex items-center justify-between px-4 py-3 border-b border-neutral-100">
                <span class="text-xs font-bold text-neutral-800">Riwayat Sesi Chat</span>
                <button id="close-chat-sidebar" class="p-1 rounded-lg hover:bg-neutral-100 text-neutral-500 cursor-pointer">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div class="p-3">
                <button id="new-chat-btn" class="w-full mb-3 flex items-center justify-center space-x-1.5 py-2 px-3 rounded-xl border border-neutral-200 hover:bg-neutral-50 text-xs font-medium transition-all cursor-pointer">
                    <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                    <span>Percakapan Baru</span>
                </button>
            </div>
            <div id="drawer-history-list" class="flex-1 overflow-y-auto custom-scrollbar px-3 space-y-1">
                <!-- Dynamic Session History -->
            </div>
        </div>

        <!-- WINDOW 1: AI Chat -->
        <div id="win-chat" class="app-window absolute inset-0 pb-16 bg-white flex flex-col z-10">
            <div class="flex items-center justify-between px-4 py-2.5 bg-white border-b border-neutral-100 shrink-0 relative">
                <button id="chat-left-btn" class="p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Riwayat Obrolan">
                    <i data-lucide="panel-left" class="w-4 h-4"></i>
                </button>
                <div class="flex space-x-1 bg-neutral-100 p-1 rounded-xl">
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-white shadow-xs text-neutral-900 transition-all cursor-pointer" data-target="chat-tab-hybrid">Hybrid</button>
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="chat-tab-templates">Template</button>
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="chat-tab-persona">Peran</button>
                </div>
                <button id="chat-right-btn" class="p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Status Auto-Fix">
                    <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                </button>
            </div>

            <!-- Window Content -->
            <div class="flex-1 overflow-hidden relative flex flex-col bg-white">
                <!-- Tab 1: Hybrid AI -->
                <div id="chat-tab-hybrid" class="tab-pane flex-1 flex flex-col p-3 md:p-5 overflow-y-auto custom-scrollbar space-y-3 max-w-3xl mx-auto w-full">
                    <div class="p-2.5 bg-neutral-50 rounded-xl border border-neutral-100 text-[11px] text-neutral-600 flex items-center justify-between">
                        <span><strong>Hybrid AI Engine:</strong> Groq + Gemini dengan Auto-Fix & Failover.</span>
                        <span id="ai-status-badge" class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 font-mono text-[9px]">Online</span>
                    </div>
                    <div id="hybrid-messages" class="space-y-2.5 flex-1"></div>
                </div>

                <!-- Tab 2: Template Prompt -->
                <div id="chat-tab-templates" class="tab-pane hidden flex-1 flex flex-col p-4 md:p-6 overflow-y-auto custom-scrollbar space-y-3 max-w-3xl mx-auto w-full">
                    <span class="text-xs font-bold text-neutral-800">Template Prompt Efisien</span>
                    <p class="text-[11px] text-neutral-500">Klik template di bawah untuk menyalin dan menggunakannya ke chat.</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
                        <div class="prompt-template-card p-3 rounded-xl border border-neutral-200 bg-white hover:border-neutral-400 transition-all cursor-pointer" data-prompt="Buatkan ringkasan kode program berikut dengan penjelasan arsitektur secara ringkas.">
                            <p class="text-xs font-semibold text-neutral-900">Analisis Kode</p>
                            <p class="text-[11px] text-neutral-500 mt-0.5">Ringkasan kode & arsitektur...</p>
                        </div>
                        <div class="prompt-template-card p-3 rounded-xl border border-neutral-200 bg-white hover:border-neutral-400 transition-all cursor-pointer" data-prompt="Bertindaklah sebagai Senior Editor. Perbaiki tata bahasa dan ejaan teks berikut agar lebih profesional.">
                            <p class="text-xs font-semibold text-neutral-900">Perbaikan Teks</p>
                            <p class="text-[11px] text-neutral-500 mt-0.5">Tingkatkan profesionalisme teks...</p>
                        </div>
                        <div class="prompt-template-card p-3 rounded-xl border border-neutral-200 bg-white hover:border-neutral-400 transition-all cursor-pointer" data-prompt="Buatkan rencana manajemen proyek (Project Plan) 3 fase secara terstruktur dan efisien.">
                            <p class="text-xs font-semibold text-neutral-900">Project Plan</p>
                            <p class="text-[11px] text-neutral-500 mt-0.5">Rencana 3 fase terstruktur...</p>
                        </div>
                        <div class="prompt-template-card p-3 rounded-xl border border-neutral-200 bg-white hover:border-neutral-400 transition-all cursor-pointer" data-prompt="Jelaskan konsep teknis kompleks berikut dengan analogi sederhana yang mudah dipahami.">
                            <p class="text-xs font-semibold text-neutral-900">Analogi Sederhana</p>
                            <p class="text-[11px] text-neutral-500 mt-0.5">Penjelasan dengan analogi...</p>
                        </div>
                    </div>
                </div>

                <!-- Tab 3: Peran AI -->
                <div id="chat-tab-persona" class="tab-pane hidden flex-1 flex flex-col p-4 md:p-6 overflow-y-auto custom-scrollbar space-y-3 max-w-3xl mx-auto w-full">
                    <span class="text-xs font-bold text-neutral-800">Pilih Peran AI (System Persona)</span>
                    <p class="text-[11px] text-neutral-500">Tentukan karakter dan gaya bahasa respons model AI.</p>
                    <div class="space-y-2 pt-1">
                        <label class="flex items-center p-3 rounded-xl border border-neutral-200 bg-white cursor-pointer hover:border-neutral-400">
                            <input type="radio" name="ai-persona" value="default" checked class="mr-3">
                            <div>
                                <p class="text-xs font-semibold text-neutral-900">Asisten Umum</p>
                                <p class="text-[10px] text-neutral-500">Ramah, netral, dan membantu segala kebutuhan.</p>
                            </div>
                        </label>
                        <label class="flex items-center p-3 rounded-xl border border-neutral-200 bg-white cursor-pointer hover:border-neutral-400">
                            <input type="radio" name="ai-persona" value="programmer" class="mr-3">
                            <div>
                                <p class="text-xs font-semibold text-neutral-900">Senior Programmer</p>
                                <p class="text-[10px] text-neutral-500">Berfokus pada efisiensi kode, arsitektur, dan best practices.</p>
                            </div>
                        </label>
                        <label class="flex items-center p-3 rounded-xl border border-neutral-200 bg-white cursor-pointer hover:border-neutral-400">
                            <input type="radio" name="ai-persona" value="copywriter" class="mr-3">
                            <div>
                                <p class="text-xs font-semibold text-neutral-900">Creative Copywriter</p>
                                <p class="text-[10px] text-neutral-500">Gaya bahasa persuasif, menarik, dan profesional.</p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Chat Input Footer -->
                <div class="p-2.5 bg-white border-t border-neutral-100 shrink-0">
                    <div class="max-w-3xl mx-auto">
                        <form id="window-chat-form" class="flex items-center space-x-2 bg-neutral-50 border border-neutral-200 rounded-2xl p-1.5 shadow-xs">
                            <input type="text" id="window-chat-input" placeholder="Ketik pesan..." class="flex-1 px-3 py-1.5 text-xs border-0 bg-transparent focus:outline-none text-neutral-900">
                            <button type="submit" class="bg-neutral-900 text-white p-2 rounded-xl hover:bg-neutral-800 cursor-pointer">
                                <i data-lucide="arrow-up" class="w-3.5 h-3.5"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>


        <!-- WINDOW 2: Workspace & Todos (Finance Manager) -->
        <div id="win-workspace" class="app-window hidden absolute inset-0 pb-16 bg-white flex flex-col z-10">
            <div class="flex items-center justify-between px-4 py-2.5 bg-white border-b border-neutral-100 shrink-0 relative">
                <button class="ws-left-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Filter">
                    <i data-lucide="filter" class="w-4 h-4"></i>
                </button>
                <div class="flex space-x-1 bg-neutral-100 p-1 rounded-xl">
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg bg-white shadow-xs text-neutral-900 transition-all cursor-pointer" data-target="ws-tab-todos">Tugas</button>
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="ws-tab-money">Uang</button>
                </div>
                <button class="ws-right-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Tambah">
                    <i data-lucide="plus-circle" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto custom-scrollbar p-4 md:p-6 max-w-3xl mx-auto w-full">
                <div id="ws-tab-todos" class="tab-pane space-y-3">
                    <div class="flex justify-between items-center pb-2 border-b border-neutral-100">
                        <span class="text-xs font-bold text-neutral-700">Daftar Tugas</span>
                        <button id="modal-sync-btn" class="text-[11px] text-blue-600 hover:underline flex items-center gap-1 cursor-pointer">
                            <i data-lucide="cloud" class="w-3 h-3"></i> Sinkron
                        </button>
                    </div>
                    <div id="modal-todo-list" class="space-y-2"></div>
                    <div class="pt-1 flex gap-2">
                        <input type="text" id="modal-todo-input" placeholder="Tugas baru..." class="flex-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        <button id="modal-add-todo" class="bg-neutral-900 text-white px-3.5 py-2 rounded-xl text-xs font-medium cursor-pointer">Tambah</button>
                    </div>
                </div>

                <div id="ws-tab-money" class="tab-pane hidden space-y-4">
                    <div class="flex justify-between items-center pb-2 border-b border-neutral-100">
                        <span class="text-xs font-bold text-neutral-800">Manajemen Keuangan & Transaksi</span>
                        <select id="currency-selector" class="text-xs bg-neutral-100 border border-neutral-200 rounded-lg px-2 py-1 focus:outline-none font-medium">
                            <option value="IDR">IDR (Rp)</option>
                            <option value="USD">USD ($)</option>
                            <option value="EUR">EUR (€)</option>
                        </select>
                    </div>

                    <div class="grid grid-cols-3 gap-2.5">
                        <div class="p-3 bg-neutral-50 rounded-2xl border border-neutral-100">
                            <p class="text-[10px] text-neutral-400">Total Saldo</p>
                            <p id="fin-balance" class="text-xs sm:text-sm font-bold text-neutral-900 mt-1">0</p>
                        </div>
                        <div class="p-3 bg-emerald-50 rounded-2xl border border-emerald-100">
                            <p class="text-[10px] text-emerald-600">Pendapatan</p>
                            <p id="fin-income" class="text-xs sm:text-sm font-bold text-emerald-700 mt-1">0</p>
                        </div>
                        <div class="p-3 bg-red-50 rounded-2xl border border-red-100">
                            <p class="text-[10px] text-red-600">Pengeluaran</p>
                            <p id="fin-expense" class="text-xs sm:text-sm font-bold text-red-700 mt-1">0</p>
                        </div>
                    </div>

                    <div class="p-3.5 bg-neutral-50 rounded-2xl border border-neutral-100 space-y-2">
                        <p class="text-xs font-bold text-neutral-800">Grafik Perbandingan Keuangan</p>
                        <div class="w-full bg-neutral-200 h-3.5 rounded-full overflow-hidden flex">
                            <div id="chart-income-bar" class="bg-emerald-500 h-full transition-all duration-500" style="width: 50%;"></div>
                            <div id="chart-expense-bar" class="bg-red-500 h-full transition-all duration-500" style="width: 50%;"></div>
                        </div>
                        <div class="flex justify-between text-[10px] text-neutral-500">
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Masuk</span>
                            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-500"></span> Keluar</span>
                        </div>
                    </div>

                    <div class="p-3.5 bg-neutral-50 rounded-2xl border border-neutral-100 space-y-2.5">
                        <p class="text-xs font-bold text-neutral-800">Catat Transaksi Baru</p>
                        <div class="grid grid-cols-2 gap-2">
                            <input type="text" id="trx-title" placeholder="Keterangan..." class="px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none bg-white">
                            <input type="number" id="trx-amount" placeholder="Nominal..." class="px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none bg-white">
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <select id="trx-type" class="px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none bg-white font-medium">
                                <option value="income">Pendapatan</option>
                                <option value="expense">Pengeluaran</option>
                            </select>
                            <select id="trx-mode" class="px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none bg-white font-medium">
                                <option value="online">Online</option>
                                <option value="offline">Offline</option>
                            </select>
                            <button id="add-trx-btn" class="bg-neutral-900 text-white py-2 rounded-xl text-xs font-medium cursor-pointer hover:bg-neutral-800 transition-all">Simpan</button>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <span class="text-xs font-bold text-neutral-800">Riwayat Transaksi</span>
                        <div id="transactions-list" class="space-y-1.5 max-h-40 overflow-y-auto custom-scrollbar"></div>
                    </div>
                </div>
            </div>
        </div>


        <!-- WINDOW 3: API Keys Management (Expanded with OpenAI & Anthropic Claude) -->
        <div id="win-apikeys" class="app-window hidden absolute inset-0 pb-16 bg-white flex flex-col z-10">
            <div class="flex items-center justify-between px-4 py-2.5 bg-white border-b border-neutral-100 shrink-0 relative">
                <button class="key-left-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Info Keamanan">
                    <i data-lucide="shield-check" class="w-4 h-4"></i>
                </button>
                <div class="flex space-x-1 bg-neutral-100 p-1 rounded-xl">
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg bg-white shadow-xs text-neutral-900 transition-all cursor-pointer" data-target="key-tab-ai">Kunci AI</button>
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="key-tab-git">Token Gist</button>
                </div>
                <button class="key-right-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Reset Kunci">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto custom-scrollbar p-4 md:p-6 max-w-xl mx-auto w-full">
                <div id="key-tab-ai" class="tab-pane space-y-3">
                    <p class="text-[11px] text-neutral-500">Konfigurasi API penyedia model AI eksternal.</p>
                    <div class="space-y-2.5">
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">Groq API Key</label>
                            <input type="password" id="input-groq-key" placeholder="gsk_..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">Gemini API Key</label>
                            <input type="password" id="input-gemini-key" placeholder="AIzaSy..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">OpenAI API Key (Opsional)</label>
                            <input type="password" id="input-openai-key" placeholder="sk-..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">Anthropic Claude API Key (Opsional)</label>
                            <input type="password" id="input-claude-key" placeholder="sk-ant-..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <button id="save-ai-keys" class="w-full bg-neutral-900 text-white py-2.5 rounded-xl text-xs font-medium cursor-pointer">Simpan Semua Kunci AI</button>
                    </div>
                </div>
                <div id="key-tab-git" class="tab-pane hidden space-y-3">
                    <p class="text-[11px] text-neutral-500">Konfigurasi sinkronisasi Gist.</p>
                    <div class="space-y-2.5">
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">GitHub Token</label>
                            <input type="password" id="input-gist-token" placeholder="ghp_..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <div>
                            <label class="text-[11px] font-semibold text-neutral-700">Gist ID</label>
                            <input type="text" id="input-gist-id" placeholder="Opsional..." class="w-full mt-1 px-3 py-2 text-xs border border-neutral-200 rounded-xl focus:outline-none focus:border-neutral-400">
                        </div>
                        <button id="save-gist-token" class="w-full bg-neutral-900 text-white py-2 rounded-xl text-xs font-medium cursor-pointer">Simpan Token</button>
                    </div>
                </div>
            </div>
        </div>


        <!-- WINDOW 4: About Developer -->
        <div id="win-developer" class="app-window hidden absolute inset-0 pb-16 bg-white flex flex-col z-10">
            <div class="flex items-center justify-between px-4 py-2.5 bg-white border-b border-neutral-100 shrink-0 relative">
                <button class="dev-left-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Statistik Dev">
                    <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
                </button>
                <div class="flex space-x-1 bg-neutral-100 p-1 rounded-xl">
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg bg-white shadow-xs text-neutral-900 transition-all cursor-pointer" data-target="dev-tab-profile">Profil</button>
                    <button class="tab-btn px-3 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="dev-tab-contact">Kontak</button>
                </div>
                <button class="dev-right-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Bagikan Profil">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto custom-scrollbar p-4 md:p-6 max-w-2xl mx-auto w-full">
                <div id="dev-tab-profile" class="tab-pane space-y-3">
                    <div class="flex items-center space-x-3">
                        <div class="w-11 h-11 rounded-xl bg-neutral-900 text-white flex items-center justify-center font-bold text-sm shadow-md">
                            DV
                        </div>
                        <div>
                            <h2 class="font-bold text-xs text-neutral-900">Danis Vanandi</h2>
                            <p class="text-[11px] text-neutral-500">vanandi@proton.me</p>
                        </div>
                    </div>
                    <div class="text-xs text-neutral-600 leading-relaxed space-y-1.5 border-t border-neutral-100 pt-3">
                        <p>Profesional dengan latar belakang Teknik Sipil dan pengalaman 4+ tahun dalam administrasi pertanahan, logistik keuangan, dan desain.</p>
                        <p>Saat ini berfokus pada pengembangan AI, NLP, dan anotasi data.</p>
                    </div>
                </div>
                <div id="dev-tab-contact" class="tab-pane hidden space-y-3">
                    <span class="text-xs font-bold text-neutral-800">Kontak</span>
                    <div class="space-y-2 text-xs text-neutral-600">
                        <div class="p-2.5 bg-neutral-50 rounded-xl border border-neutral-100">
                            <strong>Email:</strong> vanandi@proton.me
                        </div>
                        <div class="p-2.5 bg-neutral-50 rounded-xl border border-neutral-100">
                            <strong>Fokus:</strong> AI Architecture, NLP, Logistics
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- WINDOW 5: Cloud Sync Status -->
        <div id="win-sync" class="app-window hidden absolute inset-0 pb-16 bg-white flex flex-col z-10">
            <div class="flex items-center justify-between px-4 py-2.5 bg-white border-b border-neutral-100 shrink-0 relative">
                <button class="sync-left-btn p-1.5 rounded-xl hover:bg-neutral-100 text-neutral-600 transition-colors cursor-pointer" title="Periksa Jaringan">
                    <i data-lucide="wifi" class="w-4 h-4"></i>
                </button>
                <div class="flex space-x-1 bg-neutral-100 p-1 rounded-xl">
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg bg-white shadow-xs text-neutral-900 transition-all cursor-pointer" data-target="sync-tab-status">Status</button>
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="sync-tab-analytics">Statistik</button>
                    <button class="tab-btn px-2.5 py-1 text-xs font-medium rounded-lg text-neutral-600 hover:text-neutral-900 transition-all cursor-pointer" data-target="sync-tab-logs">Log</button>
                </div>

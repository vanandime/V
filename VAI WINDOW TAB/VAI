                btn.className = `w-full text-left px-3 py-2 rounded-xl text-xs truncate transition-all cursor-pointer flex items-center justify-between ${isActive ? 'bg-neutral-900 text-white font-medium' : 'text-neutral-700 hover:bg-neutral-100'}`;
                btn.innerHTML = `<span>${sess.title}</span> <span class="text-[9px] opacity-60">${sess.history.length} msg</span>`;
                btn.addEventListener('click', () => {
                    activeSessionId = sess.id;
                    localStorage.setItem('nexus_active_session', activeSessionId);
                    renderSessionsList();
                    renderActiveSessionChat();
                    chatSidebarDrawer.classList.add('-translate-x-full');
                });
                drawerList.appendChild(btn);
            });
            updateAnalytics();
        }


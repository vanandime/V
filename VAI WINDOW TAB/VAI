        function renderTransactions() {
            const listEl = document.getElementById('transactions-list');
            if (!listEl) return;
            listEl.innerHTML = '';

            let totalIncome = 0;
            let totalExpense = 0;

            if (transactions.length === 0) {
                listEl.innerHTML = '<p class="text-[11px] text-neutral-400 italic text-center py-2">Belum ada transaksi.</p>';
